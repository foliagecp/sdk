NATS_CLUSTER_MODE=true
NATS_REPLICAS=3
# Generous startup retry window: a forming/electing cluster may take a while to
# stabilize on a constrained host; the runtime retries transient JetStream
# errors during startup rather than aborting.
JS_STARTUP_RETRY_TIMEOUT_SEC=180
NATS_URL=nats://nats:foliage@nats1:4222,nats://nats:foliage@nats2:4222,nats://nats:foliage@nats3:4222
# Disable the sample's on-start workloads — this test drives its own graph.
CREATE_SIMPLE_GRAPH_TEST=false
REQUEST_REPLY_TEST=false
KV_MUTICES_TEST=false
TRIGGERS_TEST=false
